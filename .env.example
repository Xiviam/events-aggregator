DATABASE_URL=postgresql+asyncpg://events:events@postgres:5432/events
EVENTS_PROVIDER_BASE_URL=https://events-provider.dev-2.python-labs.ru
EVENTS_PROVIDER_API_KEY=
EVENTS_PROVIDER_AUTH_MODE=api_key
EVENTS_PROVIDER_EVENTS_PATH=/api/events/
EVENTS_PROVIDER_TIMEOUT_SECONDS=10
SYNC_ENABLED=true
SYNC_RUN_ON_STARTUP=true
SYNC_INTERVAL_SECONDS=86400
SYNC_BATCH_SIZE=100
SYNC_OVERLAP_SECONDS=1
SEATS_CACHE_TTL_SECONDS=30
LOG_LEVEL=INFO
